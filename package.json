{
  "name": "yarc",
  "productName": "YARC",
  "version": "0.0.0-dev",
  "description": "Yarrr! Yet Another Arc Clone: an open-source, Arc-style browser built on Electron: vertical sidebar, spaces with separate profiles, command bar, split view and Little Arc.",
  "license": "GPL-3.0-or-later",
  "author": "YARC contributors",
  "homepage": "https://github.com/yenebeb/arc-shell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yenebeb/arc-shell.git"
  },
  "bugs": {
    "url": "https://github.com/yenebeb/arc-shell/issues"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"test/unit/**/*.test.ts\"",
    "test:e2e": "pnpm build && playwright test",
    "postinstall": "node node_modules/electron/install.js",
    "dist:dir": "pnpm build && electron-builder --dir --publish never",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.3",
    "@ghostery/adblocker-electron-preload": "2.20.3",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-updater": "6.8.11",
    "tldts-experimental": "7.4.19"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.7.2",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "packageManager": "pnpm@12.16.1"
}
